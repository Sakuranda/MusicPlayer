# 复制为 deploy/.env 并按需修改（不要提交到 Git）
# 网页/API 访问令牌：留空 = 不校验；设置后前端「设置」页填同一个值
API_TOKEN=
# 网页管理员登录（两项都设置后启用账号密码 + 图片验证码）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 会话签名密钥：部署时用 `openssl rand -hex 32` 生成，切勿与密码相同
AUTH_SECRET=
# 登录保持时长（小时，默认 30 天）
SESSION_TTL_HOURS=720
# 允许跨域携带登录 Cookie 的前端来源，多个用逗号分隔
ALLOWED_ORIGINS=https://music.sakuranda.site
# 整个服务同时下载的全局并发数（默认 3，代码硬限制为最多 5）
DOWNLOAD_THREADS=3
# 解析标题时并行获取详情/标签的线程数（B站 API 仍受全局间隔约束）
METADATA_THREADS=4
# 所有 B站 JSON API 请求之间的最小间隔（秒）；数据中心 IP 建议不低于 0.5
BILI_API_INTERVAL=0.5
# LRCLIB/网易云/QQ 歌词请求之间的全局最小间隔（秒）
LYRICS_API_INTERVAL=0.35
# 本地封面最大边长与 JPEG 质量
COVER_MAX_SIZE=320
COVER_QUALITY=70
